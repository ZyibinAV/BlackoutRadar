@startuml
title BlackoutRadar — Notification Pipeline

skinparam linetype ortho

start

:Notification;
:NotificationDelivery;

fork
    :Retry Scheduler;
    :Retry Processing;
    :Atomic Claim;
    :DeliveryAttempt;
    :DeliveryResult;
    :RetryPolicy;
    :RetryDecision;
    :READY + nextAttemptAt;
    :DeliveryPort;
    :Channel Registry;
    :Delivery Adapter;
    :fenced completion;
    :Notification Finalization;
    :lock Notification;
    :read all NotificationDelivery;
    :PROCESSING / SENT / FAILED;
fork again
    :Recovery Scheduler;
    :Recovery;
    :READY;
end fork

stop

@enduml
