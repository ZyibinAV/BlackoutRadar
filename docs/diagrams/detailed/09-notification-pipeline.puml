@startuml
title BlackoutRadar — Notification Pipeline

skinparam linetype ortho

start

:Notification;
:NotificationDelivery;

fork
    :Retry Scheduler;
    :Retry Processing;
    :Atomic Claim;
    :DeliveryAttempt;
    :DeliveryResult;
    :RetryPolicy;
    :RetryDecision;
    :READY + nextAttemptAt;
    :DeliveryPort;
    :Channel Registry;
    :Delivery Adapter;
fork again
    :Recovery Scheduler;
    :Recovery;
    :READY;
end fork

stop

@enduml
