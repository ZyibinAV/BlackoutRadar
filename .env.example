# Copy this file to .env and adjust values locally.
# .env is not tracked by Git and must never be committed.

# PostgreSQL
POSTGRES_DB=blackoutradar
POSTGRES_USER=blackoutradar
# Required. Set a strong local password in .env.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# SMTP / Email delivery (TASK 26).
# Real credentials only in .env, never commit them.
MAIL_HOST=localhost
MAIL_PORT=25
# Required for a real SMTP server. Leave empty for local testing without auth.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=blackoutradar@localhost
MAIL_SUBJECT=BlackoutRadar power outage notification
